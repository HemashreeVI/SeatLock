// Open SeatLock in GitHub Codespaces (or VS Code Dev Containers) with one click.
// On start it pulls the published image and runs the full stack: Postgres, Redis, Kafka and the app.
// The app opens on port 8080 when it is ready (first start takes about 2-3 minutes).
{
  "name": "SeatLock",
  "image": "mcr.microsoft.com/devcontainers/java:1-21-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "SeatLock app", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["vscjava.vscode-java-pack", "vmware.vscode-spring-boot", "ms-azuretools.vscode-docker"] }
  }
}
