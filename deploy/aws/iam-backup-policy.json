{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteAndReadBackups",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::YOUR-BACKUP-BUCKET/postgres/*"
    },
    {
      "Sid": "ListBackups",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::YOUR-BACKUP-BUCKET"
    }
  ]
}
